  {
   "id": "hist-muscle-satellite-clin",
   "kind": "Clinical",
   "renderer": "slide",
   "study": "muscle-ls",
   "target": "satellite-1",
   "accept": [
    "satellite-1"
   ],
   "prompt": "A 22-year-old sprinter tears a hamstring. Which cell on this section will provide the new nuclei for the repaired fibres? Click it.",
   "hint": "A small lens-shaped nucleus pressed against the outside of a fibre, not inside it.",
   "view": "satellite-40x",
   "layers": [
    "none"
   ],
   "explain": "Satellite cells are quiescent stem cells lying between the sarcolemma and the basal lamina of a fibre. After injury they divide, fuse with the damaged fibre or with each other, and supply new myonuclei; mature fibres cannot divide.",
   "zoom": {
    "in": "cell:cl-0000594"
   },
   "tags": {
    "topic": "muscle",
    "region": "skeletal muscle",
    "modality": "Histology",
    "difficulty": 2
   },
